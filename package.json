{
  "name": "packref",
  "version": "0.3.0",
  "description": "Local, versioned package references for your agents",
  "keywords": [
    "agents",
    "cli",
    "dependencies",
    "npm",
    "reference",
    "source"
  ],
  "homepage": "https://github.com/metaideas/packref#readme",
  "bugs": {
    "url": "https://github.com/metaideas/packref/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaideas/packref.git"
  },
  "bin": {
    "packref": "bin/packref"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test --parallel",
    "test:coverage": "bun test --coverage",
    "test:integration": "PACKREF_INTEGRATION=1 bun test src/__tests__/integration.test.ts",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && bun run format"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@effect/platform-node": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108",
    "giget": "^3.3.1",
    "jsonc-parser": "3.3.1",
    "nanotar": "^0.3.0",
    "nypm": "^0.6.9",
    "picocolors": "1.1.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/bun": "1.3.14",
    "@types/semver": "7.8.0",
    "adamantite": "0.36.0",
    "bunup": "0.16.32",
    "figlet": "1.11.4",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
